# ─── Backend (apps/api) ───────────────────────────────────────────────
# MongoDB connection string (local docker default shown; use Atlas SRV URI in prod)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=textthem

# Server
PORT=8080
NODE_ENV=development
# Comma-separated list of allowed CORS origins (the web app URL)
CORS_ORIGINS=http://localhost:5173

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Outbound sender — set ONE of the following (at least one is required):
#  - For low volume / getting started: a plain Twilio number in E.164 format.
TWILIO_FROM_NUMBER=+15551234567
#  - Recommended once you scale / register A2P 10DLC: a Messaging Service SID.
#    If set, it takes precedence over TWILIO_FROM_NUMBER.
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public base URL the Twilio webhooks are reachable at. Used for signature validation
# and as the base of the delivery-status callback URL passed on every outbound send.
PUBLIC_BASE_URL=http://localhost:8080
# Set to "true" to skip Twilio signature validation in local dev (never in prod)
TWILIO_SKIP_SIGNATURE_VALIDATION=false
# Org info returned on HELP messages
ORG_NAME=My Organization
# Contact address included in HELP replies
SUPPORT_EMAIL=info@textthem.app

# Clerk (backend verifies JWTs). Locally, use the Clerk *development* instance's
# test keys; production (Fly + Cloudflare) uses the production instance's live
# keys, which don't accept sign-ins from localhost.
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key-here
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key-here
# Clerk user IDs allowed into the dashboard API (comma-separated). Required in
# production; leave empty locally to allow any signed-in user.
ORGANIZER_USER_IDS=

# Broadcast images (MMS) are kept in a Cloudflare R2 bucket that Twilio downloads
# them from. Set all five or none. With none, local dev keeps images in
# apps/api/.media (Twilio can't fetch those, so a real MMS send needs R2) and
# production has no "Add image" button.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=textthem-media
# R2_PUBLIC_URL=https://media.textthem.app

# ─── Frontend (apps/web) ──────────────────────────────────────────────
# These are read at build time by Vite (must be prefixed with VITE_)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key-here
VITE_API_BASE_URL=http://localhost:8080
